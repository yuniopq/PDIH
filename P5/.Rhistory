library(tuneR)
library(seewave)
library(audio)
nombre <- readWave("nombre.wav")
apellido <- readWave("apellido.wav")
nombre <- readWave("nombre.wav")
apellido <- readWave("apellido.wav")
plot(nombre)
str(apellido)
plot(apellido)
str(apellido)
nombre_completo <- pastew(apellido, nombre, at="end", output="wave")
plot(nombre_completo, main = "Forma de onda: Nombre y Apellido")
str(nombre_completo)
writeWave(nombre_completo, "basico.wav")
str(nombre_completo)
writeWave(nombre_completo, "basico.wav")
nombre_completo <- pastew(apellido, nombre, at="end", output="Wave")
str(nombre_completo)
plot(nombre_completo, main = "Forma de onda: Nombre y Apellido")
writeWave(nombre_completo, "basico.wav")
filtrado <- bwfilter(nombre_completo, f = nombre_completo@samp.rate,
from = 10000, to = 20000,
bandpass = FALSE, output = "Wave")
plot(filtrado, main = "10kHz - 20kHz filtrados")
writeWave(filtrado, "filtrado.wav")
# Aplicamos el efecto de eco
sonido_eco <- echo(nombre_completo, f = nombre_completo@samp.rate,
amp = c(0.6, 0.3), delay = c(0.4, 0.8),
output = "Wave")
# Guardamos como "eco.wav"
writeWave(sonido_eco, "eco.wav")
# Invertimos el orden de las muestras
sonido_alreves <- revw(nombre_completo, output = "Wave")
# Guardamos como "alreves.wav"
writeWave(sonido_alreves, "alreves.wav")
